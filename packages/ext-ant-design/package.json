{
  "name": "@svgr-iconkit/ant-design",
  "version": "0.5.0-alpha.0",
  "description": "AntDesignIcon for @svgr-iconkit",
  "keywords": [
    "SVG",
    "Icons",
    "react",
    "react-native",
    "expo"
  ],
  "license": "MIT",
  "repository": "https://github.com/svgr-iconkit/svgr-iconkit",
  "homepage": "https://svgr-iconkit.dev/explorer/ant-design",
  "originalAuthor": {
    "name": "Ant Design Icons",
    "url": "https://npmjs.com/package/@ant-design/icons"
  },
  "exports": {
    "./icons/*": {
      "types": "./lib/data/*.d.ts",
      "require": {
        "default": "./lib/data/*.cjs"
      },
      "default": {
        "default": "./lib/data/*.mjs"
      }
    },
    "./data/*": {
      "types": "./lib/data/*.d.ts",
      "require": {
        "default": "./lib/data/*.cjs"
      },
      "default": {
        "default": "./lib/data/*.mjs"
      }
    },
    "./native": {
      "types": "./lib/native.d.ts",
      "require": {
        "default": "./lib/native.cjs"
      },
      "import": {
        "default": "./lib/native.mjs"
      },
      "default": {
        "default": "./lib/native.cjs"
      }
    },
    ".": {
      "react-native": {
        "types": "./lib/native.d.ts",
        "default": "./lib/native.cjs"
      },
      "types": "./lib/index.d.ts",
      "require": {
        "default": "./lib/index.cjs"
      },
      "import": {
        "default": "./lib/index.mjs"
      },
      "default": {
        "default": "./lib/index.cjs"
      }
    }
  },
  "react-native": "./lib/native",
  "files": [
    "icons",
    "lib",
    "native",
    "index.js",
    "index.cjs",
    "index.mjs",
    "index.*.ts",
    "index.*.js",
    "native.js",
    "native.cjs",
    "native.mjs",
    "native.d.ts",
    "LICENSE.md",
    "README.md"
  ],
  "peerDependencies": {
    "@svgr-iconkit/core": "^0.5.0-alpha.0",
    "react": ">=16.8.0"
  },
  "peerDependenciesMeta": {
    "react-native": {
      "optional": true
    },
    "react-native-svg": {
      "optional": true
    }
  },
  "dependencies": {
    "@svgr-iconkit/core": "^0.5.0-alpha.0"
  },
  "devDependencies": {
    "@ant-design/icons-svg": "^4.4.2",
    "@svgr-iconkit/build-config": "^0.5.0-alpha.0",
    "@svgr-iconkit/cli": "^0.5.0-alpha.0",
    "@types/node": "^15.6.1",
    "npm-run-all": "^4.1.5",
    "react": "^19.1.1",
    "rimraf": "^3.0.2",
    "rollup": "^4.53.1",
    "typescript": "^5.4.4"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "iconsmap:upgrade": "yarn add -D @ant-design/icons-svg",
    "iconsmap:create:filled": "svgr-iconkit convert-data -i inline-svg/filled/ -o src/data/filled -p @ant-design/icons-svg",
    "iconsmap:create:outlined": "svgr-iconkit convert-data -i inline-svg/outlined/ -o src/data/outlined -p @ant-design/icons-svg",
    "iconsmap:create": "npm-run-all iconsmap:create:filled iconsmap:create:outlined",
    "iconsmap:prepare": "rimraf ./src/gen/ ./data/ ./src/data",
    "iconsmap": "npm-run-all iconsmap:prepare iconsmap:create",
    "prebuild": "rimraf ./lib ./dist ./gen ./icons",
    "compile": "rollup -c --bundleConfigAsCjs",
    "build": "npm-run-all compile",
    "build:full": "npm-run-all prebuild iconsmap compile"
  },
  "gitHead": "6277f374ee3386099173394f98c692819e4fc3cd"
}
