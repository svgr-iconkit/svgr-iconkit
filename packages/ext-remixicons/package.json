{
  "name": "@svgr-iconkit/remixicon",
  "version": "0.5.0-beta.1",
  "description": "remixicon for @svgr-iconkit",
  "keywords": [
    "SVG",
    "Icons",
    "react",
    "react-native",
    "expo"
  ],
  "license": "Apache 2.0",
  "repository": "https://github.com/svgr-iconkit/svgr-iconkit",
  "homepage": "https://svgr-iconkit.dev/explorer/remixicon",
  "originalAuthor": {
    "name": "Remix Icons",
    "package": "remixicon",
    "version": "2.5.0",
    "url": "https://remixicon.com/"
  },
  "exports": {
    "./icons/*": {
      "types": "./lib/data/*.d.ts",
      "require": {
        "default": "./lib/data/*.cjs"
      },
      "default": {
        "default": "./lib/data/*.mjs"
      }
    },
    "./data/*": {
      "types": "./lib/data/*.d.ts",
      "require": {
        "default": "./lib/data/*.cjs"
      },
      "default": {
        "default": "./lib/data/*.mjs"
      }
    },
    "./native": {
      "types": "./lib/native.d.ts",
      "require": {
        "default": "./lib/native.cjs"
      },
      "import": {
        "default": "./lib/native.mjs"
      },
      "default": {
        "default": "./lib/native.cjs"
      }
    },
    ".": {
      "react-native": {
        "types": "./lib/native.d.ts",
        "default": "./lib/native.cjs"
      },
      "types": "./lib/index.d.ts",
      "require": {
        "default": "./lib/index.cjs"
      },
      "import": {
        "default": "./lib/index.mjs"
      },
      "default": {
        "default": "./lib/index.cjs"
      }
    }
  },
  "react-native": "./lib/native",
  "files": [
    "icons",
    "lib",
    "native",
    "index.js",
    "index.cjs",
    "index.mjs",
    "index.*.ts",
    "index.*.js",
    "native.js",
    "native.cjs",
    "native.mjs",
    "native.d.ts",
    "LICENSE.md",
    "README.md"
  ],
  "peerDependencies": {
    "@svgr-iconkit/core": "^0.5.0-alpha.0",
    "react": ">=16.8.0"
  },
  "peerDependenciesMeta": {
    "react-native-svg": {
      "optional": true
    }
  },
  "dependencies": {
    "@svgr-iconkit/core": "^0.5.0-beta.1"
  },
  "devDependencies": {
    "@svgr-iconkit/build-config": "^0.5.0-beta.1",
    "@svgr-iconkit/cli": "^0.5.0-beta.1",
    "@types/node": "^15.6.1",
    "npm-run-all": "^4.1.5",
    "react": "^19.1.1",
    "remixicon": "^4.7.0",
    "rimraf": "^3.0.2",
    "rollup": "^4.53.1",
    "typescript": "^5.4.4"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "iconsmap:upgrade": "yarn add -D remixicon",
    "iconsmap:prepare": "rimraf ./src/gen ./src/data",
    "iconsmap:create:regular": "svgr-iconkit convert-svgfont -i fonts/remixicon.svg -o src/data/regular -p remixicon",
    "iconsmap:create": "npm-run-all iconsmap:create:regular",
    "iconsmap": "npm-run-all iconsmap:prepare iconsmap:create",
    "prebuild": "rimraf ./lib ./dist ./gen ./icons",
    "compile": "rollup -c --bundleConfigAsCjs",
    "build": "npm-run-all compile",
    "build:full": "npm-run-all prebuild iconsmap compile"
  }
}
