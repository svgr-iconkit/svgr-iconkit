{
  "name": "@svgr-iconkit/evil-icons",
  "version": "0.5.0-beta.0",
  "description": "evil-icons for @svgr-iconkit",
  "keywords": [
    "SVG",
    "Icons",
    "react",
    "react-native",
    "expo"
  ],
  "license": "MIT",
  "repository": "https://github.com/svgr-iconkit/svgr-iconkit",
  "homepage": "https://svgr-iconkit.dev/explorer/evil-icons",
  "originalAuthor": {
    "name": "Evil Icons",
    "package": "evil-icons",
    "version": "1.10.1",
    "url": "https://evil-icons.io/"
  },
  "exports": {
    "./icons/*": {
      "types": "./lib/data/*.d.ts",
      "require": {
        "default": "./lib/data/*.cjs"
      },
      "default": {
        "default": "./lib/data/*.mjs"
      }
    },
    "./data/*": {
      "types": "./lib/data/*.d.ts",
      "require": {
        "default": "./lib/data/*.cjs"
      },
      "default": {
        "default": "./lib/data/*.mjs"
      }
    },
    "./native": {
      "types": "./lib/native.d.ts",
      "require": {
        "default": "./lib/native.cjs"
      },
      "import": {
        "default": "./lib/native.mjs"
      },
      "default": {
        "default": "./lib/native.cjs"
      }
    },
    ".": {
      "react-native": {
        "types": "./lib/native.d.ts",
        "default": "./lib/native.cjs"
      },
      "types": "./lib/index.d.ts",
      "require": {
        "default": "./lib/index.cjs"
      },
      "import": {
        "default": "./lib/index.mjs"
      },
      "default": {
        "default": "./lib/index.cjs"
      }
    }
  },
  "react-native": "./lib/native",
  "files": [
    "icons",
    "lib",
    "native",
    "index.js",
    "index.cjs",
    "index.mjs",
    "index.*.ts",
    "index.*.js",
    "native.js",
    "native.cjs",
    "native.mjs",
    "native.d.ts",
    "LICENSE.md",
    "README.md"
  ],
  "peerDependencies": {
    "@svgr-iconkit/core": "^0.5.0-alpha.0",
    "react": ">=16.8.0"
  },
  "peerDependenciesMeta": {
    "react-native-svg": {
      "optional": true
    }
  },
  "dependencies": {
    "@svgr-iconkit/core": "^0.5.0-beta.0"
  },
  "devDependencies": {
    "@svgr-iconkit/build-config": "^0.5.0-beta.0",
    "@svgr-iconkit/cli": "^0.5.0-beta.0",
    "@types/node": "^15.6.1",
    "evil-icons": "^1.10.1",
    "npm-run-all": "^4.1.5",
    "react": "^19.1.1",
    "rimraf": "^3.0.2",
    "rollup": "^4.53.1",
    "typescript": "^5.4.4"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "iconsmap:upgrade": "yarn add -D evil-icons",
    "iconsmap:prepare": "rimraf ./src/gen ./src/data",
    "iconsmap:copy:regular": "svgr-iconkit deep-copy -i assets/icons -o ./src/gen/assets/regular/ -p evil-icons --remove-name-prefix 'ei-'",
    "iconsmap:create:regular": "svgr-iconkit convert-data -i ./src/gen/assets/regular/ -o ./src/data/regular/ --fill-color 'currentColor'",
    "iconsmap:create": "npm-run-all iconsmap:copy:regular iconsmap:create:regular",
    "iconsmap": "npm-run-all iconsmap:prepare iconsmap:create",
    "prebuild": "rimraf ./lib ./dist ./gen ./icons",
    "compile": "rollup -c --bundleConfigAsCjs",
    "build": "npm-run-all compile",
    "build:full": "npm-run-all prebuild iconsmap compile"
  }
}
