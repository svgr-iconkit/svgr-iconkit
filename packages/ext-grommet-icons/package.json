{
  "name": "@svgr-iconkit/grommet-icons",
  "version": "0.5.0-alpha.0",
  "description": "Grommet Icons for @svgr-iconkit",
  "keywords": [
    "SVG",
    "Icons",
    "react",
    "react-native",
    "expo"
  ],
  "license": "MIT",
  "repository": "https://github.com/svgr-iconkit/svgr-iconkit",
  "homepage": "https://svgr-iconkit.dev/explorer/grommet-icons",
  "originalAuthor": {
    "name": "grommet-icons",
    "url": "https://github.com/grommet/grommet-icons"
  },
  "exports": {
    "./icons/*": {
      "types": "./lib/data/*.d.ts",
      "require": {
        "default": "./lib/data/*.cjs"
      },
      "default": {
        "default": "./lib/data/*.mjs"
      }
    },
    "./data/*": {
      "types": "./lib/data/*.d.ts",
      "require": {
        "default": "./lib/data/*.cjs"
      },
      "default": {
        "default": "./lib/data/*.mjs"
      }
    },
    "./native": {
      "types": "./lib/native.d.ts",
      "require": {
        "default": "./lib/native.cjs"
      },
      "import": {
        "default": "./lib/native.mjs"
      },
      "default": {
        "default": "./lib/native.cjs"
      }
    },
    ".": {
      "react-native": {
        "types": "./lib/native.d.ts",
        "default": "./lib/native.cjs"
      },
      "types": "./lib/index.d.ts",
      "require": {
        "default": "./lib/index.cjs"
      },
      "import": {
        "default": "./lib/index.mjs"
      },
      "default": {
        "default": "./lib/index.cjs"
      }
    }
  },
  "react-native": "./lib/native",
  "files": [
    "icons",
    "lib",
    "native",
    "index.js",
    "index.cjs",
    "index.mjs",
    "index.*.ts",
    "index.*.js",
    "native.js",
    "native.cjs",
    "native.mjs",
    "native.d.ts",
    "LICENSE.md",
    "README.md"
  ],
  "peerDependencies": {
    "@svgr-iconkit/core": "^0.5.0-alpha.0",
    "react": ">=16.8.0"
  },
  "peerDependenciesMeta": {
    "react-native": {
      "optional": true
    },
    "react-native-svg": {
      "optional": true
    }
  },
  "dependencies": {
    "@svgr-iconkit/core": "^0.5.0-alpha.0"
  },
  "devDependencies": {
    "@svgr-iconkit/build-config": "^0.5.0-alpha.0",
    "@svgr-iconkit/cli": "^0.5.0-alpha.0",
    "@types/node": "^15.6.1",
    "grommet-icons": "^4.12.1",
    "npm-run-all": "^4.1.5",
    "react": "^19.1.1",
    "rimraf": "^3.0.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "iconsmap:upgrade": "yarn add -D grommet-icons",
    "iconsmap:prepare": "rimraf ./src/gen ./src/data",
    "iconsmap:create:regular": "svgr-iconkit convert-data -i img -p grommet-icons -o src/data/regular --stroke-color currentColor",
    "iconsmap:create": "npm-run-all iconsmap:create:regular",
    "iconsmap": "npm-run-all iconsmap:prepare iconsmap:create",
    "prebuild": "rimraf ./lib ./dist ./gen ./icons",
    "compile": "rollup -c --bundleConfigAsCjs",
    "build": "npm-run-all compile",
    "build:full": "npm-run-all iconsmap compile"
  }
}
